{
  "http": {
    "routers": {
      "ip-router": {
        "entryPoints": ["web"],
        "rule": "Host(`ip.integration.local`)",
        "service": "ip-service",
        "priority": 100
      },
      "dns-router": {
        "entryPoints": ["web"],
        "rule": "Host(`dns.integration.local`)",
        "service": "dns-service",
        "priority": 100
      }
    },
    "services": {
      "ip-service": {
        "loadBalancer": {
          "servers": [
            { "url": "http://10.0.0.42:8080" }
          ]
        }
      },
      "dns-service": {
        "loadBalancer": {
          "servers": [
            { "url": "http://example-backend.default.svc.cluster.local:80" }
          ]
        }
      }
    }
  }
}
