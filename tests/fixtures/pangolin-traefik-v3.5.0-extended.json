{
  "http": {
    "middlewares": {
      "redirect-to-https": {
        "redirectScheme": {
          "scheme": "https"
        }
      },
      "rewrite-r3-3-sdfasdf-prefix-asdf-prefix": {
        "replacePathRegex": {
          "regex": "^/sdfasdf(.*)",
          "replacement": "/asdf$1"
        }
      },
      "3-sdfasdf-prefix-asdf-prefix-headers-middleware": {
        "headers": {
          "customRequestHeaders": {
            "header1": "2asdfasdf",
            "Host": "sadfasdf"
          }
        }
      },
      "rewrite-r3-3-sadf-exact-stripPrefix": {
        "replacePathRegex": {
          "regex": "^/sadf$",
          "replacement": "/"
        }
      },
      "3-sadf-exact-stripPrefix-headers-middleware": {
        "headers": {
          "customRequestHeaders": {
            "header1": "2asdfasdf",
            "Host": "sadfasdf"
          }
        }
      },
      "rewrite-r3-3-asdf-regex-sadf-regex": {
        "replacePathRegex": {
          "regex": "asdf",
          "replacement": "sadf"
        }
      },
      "3-asdf-regex-sadf-regex-headers-middleware": {
        "headers": {
          "customRequestHeaders": {
            "header1": "2asdfasdf",
            "Host": "sadfasdf"
          }
        }
      },
      "badger": {
        "plugin": {
          "badger": {
            "apiBaseUrl": "http://pangolin:3001/api/v1",
            "userSessionCookieName": "p_session_token",
            "accessTokenQueryParam": "p_token",
            "resourceSessionRequestParam": "resource_session_request_param"
          }
        }
      }
    },
    "routers": {
      "1-test-1-router": {
        "entryPoints": [
          "websecure"
        ],
        "middlewares": [
          "badger"
        ],
        "service": "1-test-1-service",
        "rule": "Host(`whoami.fosrl.io`)",
        "priority": 100,
        "tls": {
          "certResolver": "letsencrypt"
        }
      },
      "1-test-1-router-redirect": {
        "entryPoints": [
          "web"
        ],
        "middlewares": [
          "redirect-to-https"
        ],
        "service": "1-test-1-service",
        "rule": "Host(`whoami.fosrl.io`)",
        "priority": 100
      },
      "3-sdfasdf-prefix-asdf-prefix-rt3asdf-router": {
        "entryPoints": [
          "websecure"
        ],
        "middlewares": [
          "badger",
          "rewrite-r3-3-sdfasdf-prefix-asdf-prefix",
          "3-sdfasdf-prefix-asdf-prefix-headers-middleware"
        ],
        "service": "3-sdfasdf-prefix-asdf-prefix-rt3asdf-service",
        "rule": "Host(`whoami2.fosrl.io`) && PathPrefix(`/sdfasdf`)",
        "priority": 113,
        "tls": {
          "certResolver": "letsencrypt"
        }
      },
      "3-sdfasdf-prefix-asdf-prefix-rt3asdf-router-redirect": {
        "entryPoints": [
          "web"
        ],
        "middlewares": [
          "redirect-to-https"
        ],
        "service": "3-sdfasdf-prefix-asdf-prefix-rt3asdf-service",
        "rule": "Host(`whoami2.fosrl.io`) && PathPrefix(`/sdfasdf`)",
        "priority": 113
      },
      "3-sadf-exact-stripPrefix-rt3asdf-router": {
        "entryPoints": [
          "websecure"
        ],
        "middlewares": [
          "badger",
          "rewrite-r3-3-sadf-exact-stripPrefix",
          "3-sadf-exact-stripPrefix-headers-middleware"
        ],
        "service": "3-sadf-exact-stripPrefix-rt3asdf-service",
        "rule": "Host(`whoami2.fosrl.io`) && Path(`/sadf`)",
        "priority": 115,
        "tls": {
          "certResolver": "letsencrypt"
        }
      },
      "3-sadf-exact-stripPrefix-rt3asdf-router-redirect": {
        "entryPoints": [
          "web"
        ],
        "middlewares": [
          "redirect-to-https"
        ],
        "service": "3-sadf-exact-stripPrefix-rt3asdf-service",
        "rule": "Host(`whoami2.fosrl.io`) && Path(`/sadf`)",
        "priority": 115
      },
      "3-asdf-regex-sadf-regex-rt3asdf-router": {
        "entryPoints": [
          "websecure"
        ],
        "middlewares": [
          "badger",
          "rewrite-r3-3-asdf-regex-sadf-regex",
          "3-asdf-regex-sadf-regex-headers-middleware"
        ],
        "service": "3-asdf-regex-sadf-regex-rt3asdf-service",
        "rule": "Host(`whoami2.fosrl.io`) && PathRegexp(`asdf`)",
        "priority": 112,
        "tls": {
          "certResolver": "letsencrypt"
        }
      },
      "3-asdf-regex-sadf-regex-rt3asdf-router-redirect": {
        "entryPoints": [
          "web"
        ],
        "middlewares": [
          "redirect-to-https"
        ],
        "service": "3-asdf-regex-sadf-regex-rt3asdf-service",
        "rule": "Host(`whoami2.fosrl.io`) && PathRegexp(`asdf`)",
        "priority": 112
      }
    },
    "services": {
      "1-test-1-service": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://echoserver1.dummyservices.svc.cluster.local:80"
            },
            {
              "url": "http://echoserver2.dummyservices.svc.cluster.local:80"
            }
          ]
        }
      },
      "3-sdfasdf-prefix-asdf-prefix-rt3asdf-service": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://demo.dummyservices.svc.cluster.local:80"
            }
          ],
          "sticky": {
            "cookie": {
              "name": "p_sticky",
              "secure": true,
              "httpOnly": true
            }
          },
          "serversTransport": "3-sdfasdf-prefix-asdf-prefix-transport"
        }
      },
      "3-sadf-exact-stripPrefix-rt3asdf-service": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://wordpress.dummyservices.svc.cluster.local:8080"
            }
          ],
          "sticky": {
            "cookie": {
              "name": "p_sticky",
              "secure": true,
              "httpOnly": true
            }
          },
          "serversTransport": "3-sadf-exact-stripPrefix-transport"
        }
      },
      "3-asdf-regex-sadf-regex-rt3asdf-service": {
        "loadBalancer": {
          "servers": [
            {
              "url": "http://whatever.dummyservices.svc.cluster.local:80"
            }
          ],
          "sticky": {
            "cookie": {
              "name": "p_sticky",
              "secure": true,
              "httpOnly": true
            }
          },
          "serversTransport": "3-asdf-regex-sadf-regex-transport"
        }
      }
    },
    "serversTransports": {
      "3-sdfasdf-prefix-asdf-prefix-transport": {
        "serverName": "adsf",
        "insecureSkipVerify": true
      },
      "3-sadf-exact-stripPrefix-transport": {
        "serverName": "adsf",
        "insecureSkipVerify": true
      },
      "3-asdf-regex-sadf-regex-transport": {
        "serverName": "adsf",
        "insecureSkipVerify": true
      }
    }
  },
  "tcp": {
    "routers": {
      "2-raw-router": {
        "entryPoints": [
          "tcp-234"
        ],
        "service": "2-raw-service",
        "rule": "HostSNI(`*`)"
      }
    },
    "services": {
      "2-raw-service": {
        "loadBalancer": {
          "servers": [
            {
              "address": "show.dummyservices.svc.cluster.local:8000"
            }
          ]
        }
      }
    }
  },
  "udp": {
    "routers": {
      "4-udp-router": {
        "entryPoints": [
          "udp-345"
        ],
        "service": "4-udp-service"
      }
    },
    "services": {
      "4-udp-service": {
        "loadBalancer": {
          "servers": [
            {
              "address": "http://itsnew.dummyservices.svc.cluster.local:9090"
            }
          ]
        }
      }
    }
  }
}
